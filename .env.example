# 复制为 .env 后按需填写。任何真实密钥都只放在 .env 或系统环境变量里，禁止写进代码。
# .env 已在 .gitignore 中忽略。

# ---- 本地数据 ----
HEALTH_AGENT_DATA_DIR=data
HEALTH_AGENT_DB_PATH=data/health.db

# ---- 界面 ----
HEALTH_AGENT_HOST=127.0.0.1
HEALTH_AGENT_PORT=8000

# 局域网访问开关（0=只监听本机，1=允许局域网访问）
# 置 1 时必须同时提供 HEALTH_AGENT_PASSWORD_HASH，否则程序拒绝启动
HEALTH_AGENT_LAN=0
# 用 `python -m health_agent.cli passwd` 生成，不要手写
HEALTH_AGENT_PASSWORD_HASH=

# 会话签名密钥（可选）。留空会自动生成并保存在 data/.session_secret
HEALTH_AGENT_SECRET=

# ---- AI（OpenAI 兼容接口，默认 DeepSeek）----
# 未填写时 AI 功能自动降级为本地模板文案，记录/统计/提醒不受影响。
#
# 这里的三个值现在也可以直接在界面「设置 → AI 分析接口」里填：界面保存后写回本文件、
# 立即生效（不用重启），并且只会显示密钥尾号。两种方式等价，改哪边都行。
#
# 兼容说明：DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL 是老名字，
# 仍然有效；两套都填时以 AI_* 为准，所以老 .env 不用动。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2

# 换别家就改这两项（都是 OpenAI 兼容端点，界面里有预设可参考）：
#   通义千问  AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
#   Kimi      AI_BASE_URL=https://api.moonshot.cn/v1                          AI_MODEL=moonshot-v1-8k
#   智谱 GLM  AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4                AI_MODEL=glm-4-flash
#   OpenAI    AI_BASE_URL=https://api.openai.com/v1                           AI_MODEL=gpt-4o-mini
#   本地 Ollama AI_BASE_URL=http://127.0.0.1:11434/v1                         AI_MODEL=qwen2.5:7b

# ---- 分析与提醒参数（可按需调整）----
# 睡眠目标（分钟）。不填则使用程序默认参考值 420（成人常见建议 7–9 小时的下沿），
# 提醒文案会明确标注"默认参考值、未按年龄调整"。用你自己的目标就填这里。
HEALTH_AGENT_SLEEP_TARGET_MIN=420
HEALTH_AGENT_BASELINE_WINDOW_DAYS=28
HEALTH_AGENT_BASELINE_MIN_SAMPLES=14
HEALTH_AGENT_BASELINE_MAD_FACTOR=2.5

# ---- 提醒阈值（改了立刻生效，重启后生效）----
HEALTH_AGENT_RULE_COOLDOWN_HOURS=72
HEALTH_AGENT_SLEEP_DEFICIT_DAYS=3
HEALTH_AGENT_RESTING_HR_SHIFT_BPM=8
HEALTH_AGENT_DATA_GAP_RATE=0.5

