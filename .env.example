# 复制为 .env 后按需填写。任何真实密钥都只放在 .env 或系统环境变量里，禁止写进代码。
# .env 已在 .gitignore 中忽略。

# ---- 本地数据 ----
HEALTH_AGENT_DATA_DIR=data
HEALTH_AGENT_DB_PATH=data/health.db

# ---- 界面 ----
HEALTH_AGENT_HOST=127.0.0.1
HEALTH_AGENT_PORT=8000

# 局域网访问开关（0=只监听本机，1=允许局域网访问）
# 置 1 时必须同时提供 HEALTH_AGENT_PASSWORD_HASH，否则程序拒绝启动
HEALTH_AGENT_LAN=0
# 用 `python -m health_agent.cli passwd` 生成，不要手写
HEALTH_AGENT_PASSWORD_HASH=

# 会话签名密钥（可选）。留空会自动生成并保存在 data/.session_secret
HEALTH_AGENT_SECRET=

# ---- AI（DeepSeek）----
# 未填写时 AI 功能自动降级为本地模板文案，记录/统计/提醒不受影响
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 分析与提醒参数（可按需调整）----
# 睡眠目标（分钟）。不填则使用程序默认参考值 420（成人常见建议 7–9 小时的下沿），
# 提醒文案会明确标注"默认参考值、未按年龄调整"。用你自己的目标就填这里。
HEALTH_AGENT_SLEEP_TARGET_MIN=420
HEALTH_AGENT_BASELINE_WINDOW_DAYS=28
HEALTH_AGENT_BASELINE_MIN_SAMPLES=14
HEALTH_AGENT_BASELINE_MAD_FACTOR=2.5

# ---- 提醒阈值（改了立刻生效，重启后生效）----
HEALTH_AGENT_RULE_COOLDOWN_HOURS=72
HEALTH_AGENT_SLEEP_DEFICIT_DAYS=3
HEALTH_AGENT_RESTING_HR_SHIFT_BPM=8
HEALTH_AGENT_DATA_GAP_RATE=0.5

